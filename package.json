{
  "name": "@caxperts/toolkit-plugin-sdk",
  "version": "2026.4.1",
  "description": "SDK for building Toolkit frontend plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caxperts/Toolkit.Plugins.Examples.git"
  },
  "homepage": "https://github.com/caxperts/Toolkit.Plugins.Examples#readme",
  "bugs": {
    "url": "https://github.com/caxperts/Toolkit.Plugins.Examples/issues"
  },
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./css": {
      "types": "./dist/css/prefixSelectors.d.ts",
      "default": "./dist/css/prefixSelectors.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "default": "./dist/ui/*.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "default": "./dist/data/*.js"
    },
    "./tsconfig.plugin.json": "./tsconfig.plugin.json"
  },
  "bin": {
    "toolkit-new-plugin": "scripts/new-plugin.mjs",
    "toolkit-pack-plugin": "scripts/pack-plugin.mjs"
  },
  "files": [
    "dist",
    "scripts",
    "tsconfig.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node finish-build.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-router": "^8.0.0",
    "vite": "^8.0.0",
    "devextreme": "26.1.3",
    "devextreme-react": "26.1.3"
  },
  "peerDependenciesMeta": {
    "devextreme": {
      "optional": true
    },
    "devextreme-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
