<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for this plugin.

  A plugin needs NOTHING from the internal CAXperts feed. Its only dependencies are the three host SDK
  assemblies and, transitively, EF Core — all on nuget.org. That is the point of Toolkit.Data existing
  separately from Toolkit.Infrastructure: a partner can build against the host's data model without the
  licensing package, and therefore without feed access.

  There is no nuget.config anywhere above plugins/, so without this file the plugin resolves MACHINE
  and USER level sources — whatever the developer or agent happens to have configured. Pinning
  nuget.org makes a plugin build resolve identically everywhere and matches what a partner sees, so
  "it builds here" means something.

  Scope, so nobody expects more of this file than it does: inside THIS repository the plugin references
  the host projects by path, and each of those resolves its own settings from backend/nuget.config —
  which includes the internal feed, as it must for the licensing package. So an in-repo restore still
  queries that feed, exactly as it did before the plugin moved out of backend/. This file governs the
  plugin's own resolution, which is the case a partner actually has, where those ProjectReferences
  become PackageReferences.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
