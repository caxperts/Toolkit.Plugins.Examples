{
  "name": "@toolkit-plugins/example-hello",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "build:server": "dotnet publish server -c Release -o backend",
    "build:all": "npm run build && npm run build:server",
    "validate": "node ../scripts/pack-plugin.mjs --plugin . --check",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build:all && node ../scripts/pack-plugin.mjs --plugin .",
    "stage": "npm run build:all && node ../scripts/pack-plugin.mjs --plugin . --stage",
    "stage:frontend": "npm run build && node ../scripts/pack-plugin.mjs --plugin . --stage"
  },
  "devDependencies": {
    "@caxperts/toolkit-plugin-sdk": "file:..",
    "@types/react": "^19.2.7",
    "devextreme": "26.1.3",
    "devextreme-react": "26.1.3",
    "react-router": "^8.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
